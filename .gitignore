/target
# oled-i2c is a separate git repository living inside this tree. The parent
# firmware pulls it in via a path dependency, but does NOT track its files
# (that history lives in crates/oled-i2c/.git). If you need to build the
# firmware from a fresh clone, check out oled-i2c into crates/oled-i2c first.
crates/oled-i2c/

# sdmmc-fs is a separate git repository living inside this tree, mirroring the
# oled-i2c pattern. The parent firmware pulls it in via a path dependency, but
# does NOT track its files (that history lives in crates/sdmmc-fs/.git).
crates/sdmmc-fs/
